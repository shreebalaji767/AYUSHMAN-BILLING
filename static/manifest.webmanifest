{
  "name": "BLSSNVJ21 | Ayushman Billing",
  "short_name": "BLSSNVJ21",
  "description": "BLSSNVJ21 browser-based Ayushman billing application using browser storage only.",
  "lang": "en-IN",
  "id": "/?app=BLSSNVJ21",
  "start_url": "/?app=BLSSNVJ21",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "theme_color": "#173b67",
  "background_color": "#eef1f4",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/static/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/static/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
